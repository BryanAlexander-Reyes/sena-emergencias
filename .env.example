# Plantilla de variables públicas de entorno - Fase DEPLOY.2.
# Copiar a `.env` solo en local y rellenar con valores reales.
# En Vercel, definir estas mismas dos variables en la configuración del proyecto.
# Nunca añadir service_role, secret keys, contraseñas ni access tokens a este archivo.

SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR_AQUI

# URL pública del receptor MQTT.2. Usar HTTPS accesible desde la APK.
TELEMETRY_BASE_URL=http://localhost:3000
